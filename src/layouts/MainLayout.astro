---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { getGithubRepos } from '../utils/github';
import Search from '../components/Search.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	currentPath?: string;
}

const { title = "呂依璇 Elaine Lu - Information Security Researcher", currentPath = "/" } = Astro.props;

// Fetch Stats
const posts = await getCollection('posts');
const articleCount = posts.length;

// Note: In development this might hit API limits on reload, but for static build it's fine.
const { repos } = await getGithubRepos();
const projectCount = repos.length;

const navItems = [
	{ name: 'Home', path: '/' },
	{ name: 'Projects', path: '/projects' },
	{ name: 'Blog', path: '/blog' },
	{ name: 'Contact', path: '/contact' },
];
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<ClientRouter />
</head>
<body>
	<div class="mobile-header">
		<a href="/" class="mobile-brand">
			<img src="/elaine.png" alt="Elaine Lu" class="mobile-avatar" />
			<span class="mobile-name">Elaine Lu</span>
		</a>
		<button id="menu-toggle" aria-label="Toggle Menu">
			☰
		</button>
	</div>

	<div class="wrapper">
		<!-- 左側邊欄 (Drawer on mobile) -->
		<div class="drawer-overlay" id="drawer-overlay"></div>
		<aside id="sidebar">
			<div class="profile">
				<a href="/" style="text-decoration: none; color: inherit;">
					<img src="/elaine.png" alt="Profile" class="avatar" />
					<h1>呂依璇 Elaine Lu</h1>
				</a>
				<p class="title">Information Security Researcher</p>
				<p class="bio">Always learning, always growing.</p>
			</div>

			<div class="stats">
				<div class="stat-item">
					<div class="number" id="project-count">{projectCount}</div>
					<div class="label">Projects</div>
				</div>
				<div class="stat-item">
					<div class="number" id="article-count">{articleCount}</div>
					<div class="label">Articles</div>
				</div>
			</div>

			<div class="skills">
				<h3>Tech Stack</h3>
				<div class="skill-tags">
					<span class="skill-tag">Python</span>
					<span class="skill-tag">Security</span>
					<span class="skill-tag">Linux</span>
				</div>
			</div>

			<div class="social">
				<a href="https://github.com/smadonkuan" target="_blank" title="GitHub">
					<img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/github.svg" alt="GitHub" width="20" height="20">
				</a>
				<a href="mailto:elainelu0813@gmail.com" title="Email">
					<img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/gmail.svg" alt="Email" width="20" height="20">
				</a>
				<a href="https://www.linkedin.com/in/elaine-lu-115952392/" target="_blank" title="LinkedIn">
					<img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/linkedin.svg" alt="LinkedIn" width="20" height="20">
				</a>
			</div>
		</aside>

    <!-- 主內容 -->
    <main>
      <div class="nav-tabs">
        <div class="nav-links">
          {navItems.map(item => (
            <a href={item.path} class={`nav-tab ${currentPath === item.path ? 'active' : ''}`}>
              {item.name}
            </a>
          ))}
        </div>
        <Search posts={posts} />
      </div>

      <slot />
    </main>
  </div>

  <script>
    function initMobileMenu() {
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('drawer-overlay');
      const body = document.body;

      if (!menuToggle || !sidebar || !overlay) return;

      // Remove old listeners to avoid duplicates if re-running
      menuToggle.replaceWith(menuToggle.cloneNode(true));
      overlay.replaceWith(overlay.cloneNode(true));
      
      // Re-select after cloning
      const newMenuToggle = document.getElementById('menu-toggle');
      const newOverlay = document.getElementById('drawer-overlay');

      function toggleMenu() {
        const isClosed = !sidebar.classList.contains('active');
        if (isClosed) {
          sidebar.classList.add('active');
          overlay.classList.add('active');
          body.style.overflow = 'hidden'; 
        } else {
          sidebar.classList.remove('active');
          overlay.classList.remove('active');
          body.style.overflow = '';
        }
      }

      newMenuToggle.addEventListener('click', toggleMenu);
      newOverlay.addEventListener('click', toggleMenu);

      // Close menu when clicking a link inside the sidebar
      const sidebarLinks = sidebar.querySelectorAll('a');
      sidebarLinks.forEach(link => {
        link.addEventListener('click', () => {
           sidebar.classList.remove('active');
           overlay.classList.remove('active');
           body.style.overflow = '';
        });
      });
    }

    // Run on initial load
    initMobileMenu();

    // Run on view transitions navigation
    document.addEventListener('astro:after-swap', initMobileMenu);
  </script>
</body>
</html>
