    color: var(--resume-text);
    line-height: 1.8;
    font-size: 0.95rem;
  }

  .resume-section ul {
    margin: 0;
    padding-left: 18px;
  }

  .resume-section li {
    margin-bottom: 10px;
  }

  .resume-download-btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .pdf-templates {
    position: fixed;
    left: -99999px;
    top: 0;
    width: 794px;
    pointer-events: none;
    opacity: 0;
  }

  .pdf-template {
    width: 794px;
    background: #ffffff;
    color: #111111;
    padding: 36px;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
  }

  .pdf-header h1 {
    margin: 0;
    font-size: 34px;
    line-height: 1.2;
  }

  .pdf-headline {
    margin: 10px 0 8px;
    color: #333333;
    font-size: 16px;
