---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<MainLayout title={`${post.data.title} - 呂依璇 Elaine Lu`} currentPath="/blog">
  <div class="post-container">
    <article class="post">
      <div class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span class="date">{post.data.date}</span>
          <span class="separator"> • </span>
          <span class="read-time">{post.data.readTime}</span>
        </div>
        <div class="tags">
          {post.data.tags.map((tag: unknown) => <span class="tag">{tag}</span>)}
        </div>
      </div>
      
      <div class="post-body">
        <Content />
      </div>

      <div class="post-footer">
        <a href="/blog" class="back-link">← 返回文章列表</a>
      </div>
    </article>

    <aside class="toc-sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>
</MainLayout>

<style>
  .post-container {
    display: grid;
    grid-template-columns: 1fr 240px; /* Reduced width to save main content space */
    gap: 40px;
    max-width: 100%; /* Use full width of the parent main container */
    margin: 0 auto;
    align-items: start;
    position: relative;
  }

  .post {
    max-width: 100%; /* Reset max-width since container controls it */
    min-width: 0; /* Prevent grid overflow */
  }

  /* Mobile responsiveness */
  @media (max-width: 1024px) {
    .post-container {
      grid-template-columns: 1fr;
    }

    .toc-sidebar {
      display: none;
    }
  }
</style>
