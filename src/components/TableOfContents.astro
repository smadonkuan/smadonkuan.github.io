---
// TableOfContents.astro
const { headings } = Astro.props;

// Filter only H2
const toc = headings.filter((heading: any) => heading.depth === 2);
---

<nav class="toc">
  <!-- Title removed as requested -->
  <ul>
    {toc.map((heading: any) => (
      <li class={`toc-item depth-${heading.depth}`}>
        <a href={`#${heading.slug}`} title={heading.text}>{heading.text}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Robust Active State Highlighting
  // This logic highlights the heading that is currently "active" in the viewport.
  // It handles scrolling down (highlight new) and scrolling up (highlight previous).
  
  const observerCallback = (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        if (id) {
          // Remove active class from all links
          document.querySelectorAll('.toc a').forEach((link) => {
            link.classList.remove('active');
          });
          
          // Add active class to the intersecting one
          const activeLink = document.querySelector(`.toc a[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.add('active');
          }
        }
      }
    });
  };

  const observer = new IntersectionObserver(observerCallback, {
    rootMargin: '-10% 0px -80% 0px', // Hit area near the top of the screen
    threshold: 0
  });

  // Observe all headings
  document.querySelectorAll('.post-body h2, .post-body h3').forEach((heading) => {
    observer.observe(heading);
  });
</script>

<style>
  .toc {
    position: sticky;
    top: 100px; /* Adjust based on your header/layout */
    padding: 0;
    /* border-left removed */
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    font-size: 0.85em; /* Slightly smaller to fit more text */
    line-height: 1.6;
  }

  /* toc-title style removed */

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.8rem; /* More spacing for cleaner look */
  }

  a {
    text-decoration: none;
    color: #999; /* Lighter gray for inactive */
    display: block;
    transition: color 0.2s ease;
    border: none; /* Ensure no borders */
    padding: 0;
    font-weight: 500;
    
    /* Force single line with ellipsis */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a:hover {
    color: #E8714C;
  }

  a.active {
    color: #E8714C;
    font-weight: 700;
    /* No border-left */
  }
  
  /* Hide on mobile by default */
  @media (max-width: 1024px) {
    .toc {
      display: none;
    }
  }
</style>
