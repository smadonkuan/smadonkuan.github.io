<script is:inline>
  (function () {
    const langToggleBtn = document.getElementById('lang-toggle-btn');
    const resumeContentEn = document.getElementById('resume-content-en');
    const resumeContentZh = document.getElementById('resume-content-zh');
    if (!langToggleBtn || !resumeContentEn || !resumeContentZh) return;
    langToggleBtn.addEventListener('click', () => {
      const showingZh = !resumeContentZh.hidden;
      resumeContentZh.hidden = showingZh;
      resumeContentEn.hidden = !showingZh;
      langToggleBtn.textContent = showingZh ? '中文' : 'English';
    });
  })();
</script>

<script type="module">
  import html2canvas from 'https://esm.sh/html2canvas@1.4.1';
  import { jsPDF } from 'https://esm.sh/jspdf@4.2.1';

  const downloadPdfEnButton = document.getElementById('download-pdf-en-btn');
  const downloadPdfZhButton = document.getElementById('download-pdf-zh-btn');
  const resumePdfEn = document.getElementById('resume-pdf-en');
  const resumePdfZh = document.getElementById('resume-pdf-zh');

  async function generatePdf(targetElement, buttonElement, filename) {
    if (!targetElement || !buttonElement) return;

    const originalText = buttonElement.textContent;
    buttonElement.textContent = 'Generating...';
    buttonElement.setAttribute('disabled', 'true');

    try {
      const canvas = await html2canvas(targetElement, {
        scale: 2,
        useCORS: true,
        backgroundColor: '#ffffff',
      });

      const pdf = new jsPDF({
        orientation: 'p',
        unit: 'pt',
        format: 'a4',
      });

      const pageWidth = pdf.internal.pageSize.getWidth();
      const pageHeight = pdf.internal.pageSize.getHeight();
      const margin = 24;
      const imgWidth = pageWidth - margin * 2;
      const imgHeight = (canvas.height * imgWidth) / canvas.width;
      const imgData = canvas.toDataURL('image/png');

      let heightLeft = imgHeight;
      let position = margin;

      pdf.addImage(imgData, 'PNG', margin, position, imgWidth, imgHeight, undefined, 'FAST');
      heightLeft -= pageHeight - margin * 2;

      while (heightLeft > 0) {
        position = margin - (imgHeight - heightLeft);
        pdf.addPage();
        pdf.addImage(imgData, 'PNG', margin, position, imgWidth, imgHeight, undefined, 'FAST');
        heightLeft -= pageHeight - margin * 2;
      }

      pdf.save(filename);
    } finally {
      buttonElement.removeAttribute('disabled');
      buttonElement.textContent = originalText ?? 'Download PDF';
    }
  }

  downloadPdfEnButton?.addEventListener('click', () => {
    generatePdf(resumePdfEn, downloadPdfEnButton, 'elainelu_resume_EN.pdf');
  });

  downloadPdfZhButton?.addEventListener('click', () => {
    generatePdf(resumePdfZh, downloadPdfZhButton, '呂依璇_履歷_ZH.pdf');
  });
</script>

<style>
  .resume-page {
    --resume-accent: #4a63d8;
