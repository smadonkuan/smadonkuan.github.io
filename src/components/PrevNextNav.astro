---
interface PostLink {
  slug: string;
  title: string;
}
interface Props {
  prev?: PostLink | null;
  next?: PostLink | null;
  seriesName?: string | null;
  seriesPrev?: PostLink | null;
  seriesNext?: PostLink | null;
}
const { prev, next, seriesName, seriesPrev, seriesNext } = Astro.props;
const hasDefault = prev || next;
const hasSeries = seriesName && (seriesPrev || seriesNext);
if (!hasDefault && !hasSeries) return null;
---

<nav class="prev-next-nav" aria-label="上一篇／下一篇">
  {hasSeries && (
    <div class="prev-next-series">
      <span class="prev-next-series-label">同系列：{seriesName}</span>
      <div class="prev-next-inner">
        {seriesPrev ? (
          <a href={`/posts/${seriesPrev.slug}`} class="prev-next-link prev">
            <span class="prev-next-label">← 上一篇</span>
            <span class="prev-next-title">{seriesPrev.title}</span>
          </a>
        ) : <span class="prev-next-placeholder" />}
        {seriesNext ? (
          <a href={`/posts/${seriesNext.slug}`} class="prev-next-link next">
            <span class="prev-next-label">下一篇 →</span>
            <span class="prev-next-title">{seriesNext.title}</span>
          </a>
        ) : <span class="prev-next-placeholder" />}
      </div>
    </div>
  )}
  {hasDefault && (
    <div class="prev-next-inner">
      {prev ? (
        <a href={`/posts/${prev.slug}`} class="prev-next-link prev">
          <span class="prev-next-label">← 上一篇</span>
          <span class="prev-next-title">{prev.title}</span>
        </a>
      ) : (
        <span class="prev-next-placeholder" />
      )}
      {next ? (
        <a href={`/posts/${next.slug}`} class="prev-next-link next">
          <span class="prev-next-label">下一篇 →</span>
          <span class="prev-next-title">{next.title}</span>
        </a>
      ) : (
        <span class="prev-next-placeholder" />
      )}
    </div>
  )}
</nav>

<style>
  .prev-next-nav {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e0e0e0;
  }
  .prev-next-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .prev-next-link {
    display: block;
    padding: 12px 16px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  .prev-next-link:hover {
    border-color: #E8714C;
    background: #fff9f7;
  }
  .prev-next-link.next {
    text-align: right;
  }
  .prev-next-label {
    display: block;
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 4px;
  }
  .prev-next-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: #1A3A52;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prev-next-link:hover .prev-next-title {
    color: #E8714C;
  }
  .prev-next-placeholder {
    display: block;
  }
  .prev-next-series {
    margin-bottom: 1rem;
  }
  .prev-next-series-label {
    display: block;
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 640px) {
    .prev-next-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
