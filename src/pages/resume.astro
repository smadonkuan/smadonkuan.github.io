  .resume-header h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
  }

  .headline {
    margin: 10px 0 8px;
    color: var(--resume-text-soft);
    font-size: 1rem;
  }

  .contact-line {
    margin: 0;
    color: var(--resume-text-muted);
    font-size: 0.92rem;
