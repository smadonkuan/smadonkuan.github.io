---
import { getCollection } from 'astro:content';

const pageTitle = 'Elaine Lu';
const latestPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}.${month}.${day}`;
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="Elaine Lu 的技術部落格：資安、網路、程式與專案筆記，以長文整理學習與研究心得。" />
  </head>
  <body class="home-index">
    <div class="page-shell">
      <header class="landing-top-nav">
        <a href="/" class="landing-home-btn" aria-current="page" aria-label="回到主頁">← Home</a>
        <nav class="landing-nav-links" aria-label="Main navigation">
          <a href="/projects" class="landing-nav-link">Projects</a>
          <a href="/about" class="landing-nav-link">About</a>
          <a href="/blog" class="landing-nav-link">Blog</a>
          <a href="/contact" class="landing-nav-link">Contact</a>
        </nav>
      </header>

      <main class="hero snap-panel panel reveal is-active" style="--reveal-delay: 0s;">
        <div class="hero-bg" aria-hidden="true"></div>

        <section class="profile-card reveal reveal-up" style="--reveal-delay: 0.05s;">
          <div class="photo-stage">
            <div class="photo-ring">
              <img src="/elaine.png" alt="呂依璇 Elaine Lu" class="profile-photo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <div class="photo-fallback" aria-hidden="true">EL</div>
            </div>
          </div>
          <div class="profile-text">
            <h1 class="hero-title">{pageTitle}</h1>
            <p class="profile-bio">這裡大多是一些隨手記錄的研究筆記，偶爾也會寫程式、實驗與讀書心得。</p>
          </div>
        </section>

        <nav class="cta-list reveal reveal-up" style="--reveal-delay: 0.12s;" aria-label="快速入口">
          <a class="cta-link" href="/blog">
            <span class="cta-arrow" aria-hidden="true">→</span><span class="cta-label">Blog</span>
          </a>
          <a class="cta-link" href="/projects">
            <span class="cta-arrow" aria-hidden="true">→</span><span class="cta-label">Projects</span>
          </a>
          <a class="cta-link" href="https://github.com/smadonkuan" target="_blank" rel="noopener noreferrer">
            <span class="cta-arrow" aria-hidden="true">→</span><span class="cta-label">GitHub</span>
          </a>
          <a class="cta-link" href="https://www.linkedin.com/in/elaine-lu-115952392" target="_blank" rel="noopener noreferrer">
            <span class="cta-arrow" aria-hidden="true">→</span><span class="cta-label">LinkedIn</span>
          </a>
        </nav>
      </main>

      <section class="home-extra snap-panel panel reveal" style="--reveal-delay: 0s;">
        <div class="latest-posts reveal reveal-up" style="--reveal-delay: 0.12s;">
          <div class="latest-header">
            <div class="section-label-wrap">
              <span class="section-label">From the blog</span>
              <h2>最近更新</h2>
            </div>
            <a class="latest-all" href="/blog">所有文章</a>
          </div>
          {latestPosts.length === 0 ? (
            <p class="empty-note">目前沒有文章</p>
          ) : (
            <div class="post-list">
              {latestPosts.map((post, index) => (
                <a
                  href={`/posts/${post.slug}`}
                  class="post-item reveal reveal-up"
                  style={`--reveal-delay: ${0.06 * (index + 1)}s;`}
                >
                  <span class="post-date">{formatDate(post.data.date)}</span>
                  <h3>{post.data.title}</h3>
                  <span class="post-readtime">{post.data.readTime || '5 min read'}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    </div>
    <script>
      function initScrollReveal() {
        const revealElements = document.querySelectorAll('.reveal');
        if (!revealElements.length) return;

        if (!('IntersectionObserver' in window)) {
          revealElements.forEach((el) => el.classList.add('active'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('active');
            obs.unobserve(entry.target);
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px',
        });

        revealElements.forEach((el) => observer.observe(el));
      }

      /** 讓整屏區塊在進入視窗時有「換頁」感（panel 縮放／透明度） */
      function initSnapPanelState() {
        const panels = Array.from(document.querySelectorAll('.snap-panel'));
        if (!panels.length || !('IntersectionObserver' in window)) {
          panels.forEach((p) => p.classList.add('is-active'));
          return;
        }

        const setActive = (active) => {
          panels.forEach((p) => p.classList.toggle('is-active', p === active));
        };

        const io = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting && e.intersectionRatio > 0)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (visible) setActive(visible.target);
          },
          { threshold: [0, 0.15, 0.35, 0.55, 0.75, 1], rootMargin: '-8% 0px -8% 0px' },
        );

        panels.forEach((p) => io.observe(p));
      }

      /**
       * 接近 Apple 官網：一次滾輪傾向捲到下一／上一整屏（僅在區塊邊界、且未開啟減少動畫時）
       */
      function isVerticallyScrollable(el) {
        if (!el || !(el instanceof Element)) return false;
        const st = getComputedStyle(el);
        const oy = st.overflowY;
        if (oy !== 'auto' && oy !== 'scroll' && oy !== 'overlay') return false;
        return el.scrollHeight > el.clientHeight + 2;
      }

      /** 游標在可內部捲動區且還能捲時，不攔截滾輪 */
      function wheelShouldBubbleToPage(e, dy) {
        let node = e.target;
        while (node && node !== document.body) {
          if (isVerticallyScrollable(node)) {
            const top = node.scrollTop;
            const max = node.scrollHeight - node.clientHeight;
            if (dy > 0 && top < max - 1) return false;
            if (dy < 0 && top > 1) return false;
          }
          node = node.parentElement;
        }
        return true;
      }

      function initWheelSnapAssist() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const panels = Array.from(document.querySelectorAll('.snap-panel'));
        if (panels.length < 2) return;

        let lock = false;
        const unlock = () => {
          lock = false;
        };

        window.addEventListener(
          'wheel',
          (e) => {
            if (lock) return;
            const dy = e.deltaY;
            if (Math.abs(dy) < 32) return;
            if (!wheelShouldBubbleToPage(e, dy)) return;

            const midY = window.innerHeight * 0.45;
            let idx = 0;
            panels.forEach((p, i) => {
              const r = p.getBoundingClientRect();
              if (r.top <= midY && r.bottom >= midY) idx = i;
            });

            if (dy > 0 && idx < panels.length - 1) {
              e.preventDefault();
              lock = true;
              panels[idx + 1].scrollIntoView({ behavior: 'smooth', block: 'start' });
              window.setTimeout(unlock, 780);
            } else if (dy < 0 && idx > 0) {
              e.preventDefault();
              lock = true;
              panels[idx - 1].scrollIntoView({ behavior: 'smooth', block: 'start' });
              window.setTimeout(unlock, 780);
            }
          },
          { passive: false },
        );
      }

      function boot() {
        const isMobile = window.matchMedia('(max-width: 920px)').matches;
        if (isMobile) return;
        initScrollReveal();
        initSnapPanelState();
        initWheelSnapAssist();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>

<style>
  :global(:root) {
    --landing-bg: #f5f5f7;
    --landing-text: #1d1d1f;
    --landing-text-soft: #515561;
    --landing-accent: #4a63d8;
    --landing-accent-soft: rgba(74, 99, 216, 0.1);
    --landing-border: rgba(74, 99, 216, 0.22);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-snap-type: y mandatory;
    scroll-padding-top: calc(env(safe-area-inset-top, 0px) + 56px);
  }

  :global(body.home-index) {
    margin: 0;
    min-height: 100vh;
    /* 與 src/styles/global.css body、文章頁 MainLayout 一致 */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
    background: linear-gradient(to bottom, #f5f5f3, #ececea);
    color: #111827;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    -webkit-font-smoothing: antialiased;
  }

  .page-shell {
    min-height: 100vh;
    width: min(1080px, 100%);
    margin: 0 auto;
    padding: clamp(18px, 3vw, 34px) clamp(16px, 3vw, 30px);
    display: flex;
    flex-direction: column;
  }

  .landing-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    margin-bottom: clamp(1.2rem, 3vw, 2.2rem);
  }

  .landing-home-btn {
    color: #515561;
    text-decoration: none;
    font-family: 'JetBrains Mono', 'SFMono-Regular', 'Consolas', 'Menlo', monospace;
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    border: 1px solid rgba(74, 99, 216, 0.28);
    border-radius: 999px;
    padding: 4px 10px;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .landing-home-btn:hover {
    color: var(--landing-accent);
    border-color: var(--landing-accent);
    background: rgba(138, 160, 255, 0.08);
  }

  .landing-nav-links {
    display: flex;
    gap: clamp(0.8rem, 2vw, 1.3rem);
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .landing-nav-link {
    color: var(--landing-text-soft);
    text-decoration: none;
    font-family: 'JetBrains Mono', 'SFMono-Regular', 'Consolas', 'Menlo', monospace;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .landing-nav-link:hover,
  .landing-nav-link.active {
    color: var(--landing-accent);
    border-color: var(--landing-accent);
  }

  .snap-panel {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-margin-top: calc(env(safe-area-inset-top, 0px) + 52px);
  }

  .hero {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 4vw, 3rem);
    min-height: 100dvh;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 10% -10% auto 20%;
    height: min(60vh, 520px);
    background: radial-gradient(ellipse at center, rgba(120, 140, 200, 1), transparent 60%);
    opacity: 0.08;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }

  .hero > .profile-card,
  .hero > .cta-list {
    position: relative;
    z-index: 1;
  }

  .profile-card {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2rem);
    width: 100%;
    max-width: 720px;
  }

  .profile-text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    flex: 1;
  }

  .profile-bio {
    margin: 0;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.65;
    color: rgba(30, 30, 30, 0.78);
  }

  .cta-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    width: 100%;
    max-width: 480px;
  }

  .cta-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--landing-text);
    font-size: 0.95rem;
    font-weight: 500;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.5);
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .cta-link:hover {
    border-color: var(--landing-accent);
    color: var(--landing-accent);
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-1px);
  }

  .cta-arrow {
    display: none;
  }

  .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0s);
    will-change: opacity, transform;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .panel {
    opacity: 0.55;
    transform: translateY(18px) scale(0.992);
    filter: blur(0.4px);
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  .home-extra {
    margin-top: 0;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: max(clamp(16px, 3vw, 30px), env(safe-area-inset-left, 0px));
    padding-right: max(clamp(16px, 3vw, 30px), env(safe-area-inset-right, 0px));
    padding-bottom: clamp(2rem, 6vh, 4rem);
    box-sizing: border-box;
    display: grid;
    gap: clamp(1.6rem, 3vw, 2.4rem);
    min-height: 100dvh;
    align-content: center;
    justify-content: center;
  }

  .latest-posts {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .latest-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    gap: 12px;
    flex-wrap: wrap;
  }

  .section-label-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .section-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #6b6b6b;
  }

  .latest-header h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: #1d1d1f;
  }

  .latest-all {
    color: var(--landing-accent);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(74, 99, 216, 0.32);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .latest-all:hover {
    background: var(--landing-accent-soft);
    color: #2f3eb0;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .post-item {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 0;
    transition: transform 0.18s ease;
  }

  .post-item:hover h3 {
    color: var(--landing-accent);
  }

  .post-date {
    font-family: 'JetBrains Mono', 'SFMono-Regular', 'Consolas', 'Menlo', monospace;
    font-size: 0.82rem;
    color: #6b6b6b;
    letter-spacing: 0.02em;
  }

  .post-item h3 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.45;
    font-weight: 600;
    color: #1d1d1f;
    transition: color 0.2s ease;
  }

  .post-readtime {
    font-family: 'JetBrains Mono', 'SFMono-Regular', 'Consolas', 'Menlo', monospace;
    font-size: 0.78rem;
    color: #6b6b6b;
    letter-spacing: 0.02em;
  }

  .empty-note {
    margin: 0;
    color: #6b6b6b;
    font-size: 0.9rem;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .photo-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-stage .photo-ring {
    position: relative;
    z-index: 1;
  }

  .photo-ring {
    width: clamp(200px, 28vw, 325px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 0 80px rgba(80, 120, 255, 0.15);
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .photo-fallback {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: clamp(2rem, 7vw, 3.6rem);
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(145deg, #3f3f46, #18181b);
    letter-spacing: 0.08em;
  }

  @media (max-width: 920px) {
    .hero {
      gap: 1.5rem;
    }

    .profile-card {
      gap: 0.9rem;
      align-items: center;
    }

    .profile-bio {
      display: none;
    }

    .hero-title {
      font-size: clamp(1.6rem, 6vw, 2rem);
    }

    .home-extra {
      margin-top: 2rem;
    }

    .photo-ring {
      width: 96px;
    }

    .cta-link {
      font-size: 1.05rem;
      padding: 12px 0;
    }
  }

  @media (max-width: 680px) {
    .landing-top-nav {
      position: sticky;
      top: 0;
      z-index: 20;
      margin-bottom: 1rem;
      padding: calc(8px + env(safe-area-inset-top, 0px)) max(10px, env(safe-area-inset-right, 0px)) 8px
        max(10px, env(safe-area-inset-left, 0px));
      background: #f5f5f3;
      border-bottom: 1px solid rgba(74, 99, 216, 0.18);
    }

    .landing-nav-links {
      width: auto;
      justify-content: flex-end;
      flex-wrap: nowrap;
      gap: 0.9rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    .landing-nav-links::-webkit-scrollbar {
      display: none;
    }

    .landing-nav-link {
      white-space: nowrap;
      padding: 4px 0;
    }

    .landing-home-btn {
      font-size: 0.72rem;
      padding: 4px 9px;
      margin-right: 10px;
      flex-shrink: 0;
    }

    .hero {
      gap: 1.3rem;
      min-height: 100dvh;
    }

    .photo-ring {
      width: 120px;
    }

    .home-extra {
      min-height: 100dvh;
      align-content: start;
      justify-content: flex-start;
      padding-top: 0.5rem;
    }
  }

  @media (max-width: 520px) {
    .page-shell {
      padding: 10px 14px 24px;
    }

    .landing-nav-links {
      gap: 0.75rem;
    }

    .photo-ring {
      width: 84px;
    }
  }

  @media (max-width: 390px) {
    .cta-link {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .panel {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .post-item:hover {
      transform: none;
    }

    :global(html) {
      scroll-snap-type: none;
    }

    :global(body.home-index) {
      scroll-snap-type: none;
    }
  }

  /* 手機版：滑順優先，關掉桌機 scroll-snap、整屏 dvh 與進場特效 */
  @media (max-width: 920px) {
    :global(html) {
      scroll-snap-type: none;
    }

    :global(body.home-index) {
      scroll-snap-type: none;
    }

    .snap-panel {
      min-height: auto;
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }

    .hero,
    .home-extra {
      min-height: auto;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .panel {
      opacity: 1;
      transform: none;
      filter: none;
    }

    /* 拿掉 hero 背景大型 blur，避免 scroll 時 GPU 重繪 */
    .hero-bg {
      display: none;
    }
  }
</style>
