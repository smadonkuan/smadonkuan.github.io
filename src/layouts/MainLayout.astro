---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { getGithubRepos } from '../utils/github';
import Search from '../components/Search.astro';
import VisitorCount from '../components/VisitorCount.astro';
import BackToTop from '../components/BackToTop.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	currentPath?: string;
	description?: string;
	canonicalUrl?: string;
	ogImage?: string;
}

const { title = "呂依璇 Elaine Lu - Information Security Researcher", currentPath = "/", description, canonicalUrl, ogImage } = Astro.props;
const siteUrl = import.meta.env.SITE ?? 'https://smadonkuan.github.io';
const fullOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href) : new URL('/elaine.png', siteUrl).href;

// Fetch Stats
const posts = await getCollection('posts');
const articleCount = posts.length;

// Note: In development this might hit API limits on reload, but for static build it's fine.
const { repos } = await getGithubRepos();
const projectCount = repos.length;

const navItems = [
	{ name: 'Home', path: '/' },
	{ name: 'Projects', path: '/projects' },
	{ name: 'Blog', path: '/blog' },
	{ name: 'Contact', path: '/contact' },
];

// 選用：Plausible Analytics，可看到訪客來源、UTM（哪個 IG 連結）
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
	<meta property="og:title" content={title} />
	{description && <meta property="og:description" content={description} />}
	<meta property="og:image" content={fullOgImage} />
	{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
	<meta property="og:type" content={canonicalUrl ? "article" : "website"} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	{description && <meta name="twitter:description" content={description} />}
	<!-- RSS 先註解
	<link rel="alternate" type="application/rss+xml" title="呂依璇 Elaine Lu - Blog RSS" href="/rss.xml" />
	-->
	{plausibleDomain && <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />}
	<ClientRouter />
</head>
<body>
	<div class="mobile-header">
		<a href="/" class="mobile-brand">
			<img src="/elaine.png" alt="Elaine Lu" class="mobile-avatar" />
			<span class="mobile-name">Elaine Lu</span>
		</a>
		<div class="mobile-header-actions">
			<ThemeToggle />
			<button id="menu-toggle" type="button" aria-label="開啟選單">
				<span aria-hidden="true">☰</span>
			</button>
		</div>
	</div>

	<div class="wrapper">
		<!-- 左側邊欄 (Drawer on mobile) -->
		<div class="drawer-overlay" id="drawer-overlay"></div>
		<aside id="sidebar">
			<div class="profile">
				<a href="/" style="text-decoration: none; color: inherit;">
					<img src="/elaine.png" alt="Profile" class="avatar" />
					<h1>呂依璇 Elaine Lu</h1>
				</a>
				<p class="title">Information Security Researcher</p>
				<p class="bio">Always learning, always growing.</p>
			</div>

			<div class="stats">
				<div class="stat-item">
					<div class="number" id="project-count">{projectCount}</div>
					<div class="label">Projects</div>
				</div>
				<div class="stat-item">
					<div class="number" id="article-count">{articleCount}</div>
					<div class="label">Articles</div>
				</div>
			</div>

			<div class="skills">
				<h3>Tech Stack</h3>
				<div class="skill-tags">
					<span class="skill-tag">Python</span>
					<span class="skill-tag">Security</span>
					<span class="skill-tag">Linux</span>
				</div>
			</div>

			<div class="social">
				<a href="https://github.com/smadonkuan" target="_blank" title="GitHub">
					<img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/github.svg" alt="GitHub" width="20" height="20">
				</a>
				<a href="mailto:elainelu0813@gmail.com" title="Email">
					<img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/gmail.svg" alt="Email" width="20" height="20">
				</a>
				<a href="https://www.linkedin.com/in/elaine-lu-115952392/" target="_blank" title="LinkedIn">
					<img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/linkedin.svg" alt="LinkedIn" width="20" height="20">
				</a>
			</div>
			<div class="sidebar-extra">
				<ThemeToggle />
			</div>
		</aside>

    <!-- 主內容 -->
    <main>
      <div class="nav-tabs">
        <div class="nav-links">
          {navItems.map(item => (
            <a href={item.path} class={`nav-tab ${currentPath === item.path ? 'active' : ''}`}>
              {item.name}
            </a>
          ))}
        </div>
        <div class="nav-search-wrap">
          <Search posts={posts} />
        </div>
      </div>

      <slot />
    </main>
  </div>

  <VisitorCount />
  <BackToTop />
  <div id="konami-toast" class="konami-toast" aria-live="polite" hidden>🎮 密技解鎖！</div>

  <script>
    function initMobileMenu() {
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('drawer-overlay');
      const body = document.body;

      if (!menuToggle || !sidebar || !overlay) return;

      // Remove old listeners to avoid duplicates if re-running
      menuToggle.replaceWith(menuToggle.cloneNode(true));
      overlay.replaceWith(overlay.cloneNode(true));
      
      // Re-select after cloning
      const newMenuToggle = document.getElementById('menu-toggle');
      const newOverlay = document.getElementById('drawer-overlay');

      function openMenu() {
        sidebar.classList.add('active');
        newOverlay.classList.add('active');
        body.classList.add('menu-open');
        body.style.overflow = 'hidden';
      }

      function closeMenu() {
        sidebar.classList.remove('active');
        newOverlay.classList.remove('active');
        body.classList.remove('menu-open');
        body.style.overflow = '';
      }

      // 打開／關閉：按 menu-toggle 或點 overlay 都可
      newMenuToggle.addEventListener('click', () => {
        if (sidebar.classList.contains('active')) closeMenu();
        else openMenu();
      });

      // 關閉：點擊任意處（overlay），不包含彈出視窗（sidebar）
      newOverlay.addEventListener('click', closeMenu);

      // 點側欄內連結時也關閉
      const sidebarLinks = sidebar.querySelectorAll('a');
      sidebarLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    }

    // Run on initial load
    initMobileMenu();

    // Run on view transitions navigation
    document.addEventListener('astro:after-swap', initMobileMenu);

    // 鍵盤快捷鍵：/ 聚焦搜尋、Esc 關閉選單
    function isInputOrTextarea(el) {
      if (!el) return false;
      const tag = el.tagName?.toLowerCase();
      return tag === 'input' || tag === 'textarea' || el.isContentEditable;
    }
    document.addEventListener('keydown', function(e) {
      // Cmd/Ctrl + K 或 Cmd/Ctrl + / 來觸發搜尋
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K' || e.key === '/')) {
        if (!isInputOrTextarea(document.activeElement)) {
          e.preventDefault();
          document.getElementById('search-input')?.focus();
        }
      }
      // 單獨按 / 也可以（如果不在輸入框中）
      if (e.key === '/' && !isInputOrTextarea(document.activeElement) && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        document.getElementById('search-input')?.focus();
      }
      if (e.key === 'Escape') {
        document.getElementById('sidebar')?.classList.remove('active');
        document.getElementById('drawer-overlay')?.classList.remove('active');
        document.body.classList.remove('menu-open');
        document.body.style.overflow = '';
      }
    });

    // Konami 密技 ↑↑↓↓←→←→BA
    var konami = [38, 38, 40, 40, 37, 39, 37, 39, 66, 65];
    var konamiIdx = 0;
    document.addEventListener('keydown', function(e) {
      if (e.keyCode === konami[konamiIdx]) {
        konamiIdx++;
        if (konamiIdx === konami.length) {
          konamiIdx = 0;
          var toast = document.getElementById('konami-toast');
          if (toast) {
            toast.removeAttribute('hidden');
            toast.classList.add('show');
            setTimeout(function() {
              toast.classList.remove('show');
              setTimeout(function() { toast.setAttribute('hidden', ''); }, 300);
            }, 2000);
          }
        }
      } else {
        konamiIdx = 0;
      }
    });
  </script>
  <style is:global>
    .sidebar-extra { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: center; }
    .mobile-header-actions { display: flex; align-items: center; gap: 8px; }
    .konami-toast { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%); padding: 12px 24px; background: var(--accent); color: #fff; border-radius: 8px; font-weight: 600; z-index: 9999; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
    .konami-toast.show { opacity: 1; }
  </style>
</body>
</html>
