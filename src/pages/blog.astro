---
import LandingLayout from '../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}年${month}月${day}日`;
}
---

<LandingLayout title="Blog - 呂依璇 Elaine Lu" currentPath="/blog">
    <div class="page post post-list">
        <div class="blog-header">
          <h1 class="section-title">所有文章</h1>
          <a href="/blog/archive" class="archive-link" title="依年／月彙整">依年／月彙整</a>
        </div>

        {allTags.length > 0 && (
          <div class="tag-cloud">
            <span class="tag-cloud-label">標籤：</span>
            {allTags.map((tag) => (
              <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="tech-badge tag-link">{tag}</a>
            ))}
          </div>
        )}
        
        <div id="posts-container">
            {posts.length === 0 ? (
                <p style="text-align: center; color: #999;">目前沒有文章</p>
            ) : (
                posts.map((post) => (
                    <div class="blog-card">
                        <h3><a href={`/posts/${post.slug}`} style="color: inherit; text-decoration: none;">{post.data.title}</a></h3>
                        <div class="project-meta">
                            <span>{formatDate(post.data.date)}</span> • <span>{post.data.readTime || '5 min read'}</span>
                        </div>
                        <p>{post.data.excerpt}</p>
                        <div class="tech-stack">
                            {post.data.tags.map((tag: string) => (
                              <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="tech-badge tag-link">{tag}</a>
                            ))}
                        </div>
                        <a href={`/posts/${post.slug}`} class="btn">Read Article →</a>
                    </div>
                ))
            )}
        </div>
    </div>
</LandingLayout>
