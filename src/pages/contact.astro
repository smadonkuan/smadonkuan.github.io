---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact - 呂依璇 Elaine Lu" currentPath="/contact">
    <div class="contact-container">
        <h2>聯絡我</h2>
        <p>如果你對資訊安全感興趣，或有想討論的研究專案，歡迎透過以下方式與我聯繫。</p>

        <div class="contact-content">
            <!-- Email -->
            <div class="contact-method">
                <h3>電子郵件</h3>
                <p>可以發Email給我</p>
                <a href="mailto:elainelu0813@gmail.com">發送郵件</a>
            </div>

            <div class="divider"></div>

            <!-- GitHub -->
            <div class="contact-method">
                <h3>GitHub</h3>
                <p>查看我的GitHub（ 但裡面沒東西 ）。</p>
                <a href="https://github.com/smadonkuan" target="_blank">訪問 GitHub</a>
            </div>

            <div class="divider"></div>

            <!-- LinkedIn -->
            <div class="contact-method">
                <h3>LinkedIn</h3>
                <p>歡迎與我建立連結</p>
                <a href="https://www.linkedin.com/in/elaine-lu-115952392/" target="_blank">訪問 LinkedIn</a>
            </div>
        </div>

        <div class="contact-footer">
            期待與你的合作 ～
        </div>
    </div>
</MainLayout>

<style>
    .contact-container {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 60px 50px;
        max-width: 100%;
    }

    .contact-container h2 {
        font-size: 32px;
        font-weight: 700;
        color: #1A3A52;
        margin-bottom: 15px;
    }

    .contact-container > p:first-of-type {
        font-size: 16px;
        color: #666;
        line-height: 1.8;
        margin-bottom: 40px;
    }

    .contact-content {
        display: flex;
        gap: 0;
        margin-bottom: 40px;
        align-items: flex-start;
    }

    .contact-method {
        flex: 1;
        padding: 0 25px;
    }

    .contact-method:first-child {
        padding-left: 0;
    }

    .contact-method:last-child {
        padding-right: 0;
    }

    .contact-method h3 {
        font-size: 18px;
        font-weight: 700;
        color: #1A3A52;
        margin-bottom: 10px;
    }

    .contact-method p {
        font-size: 14px;
        color: #666;
        line-height: 1.7;
        margin-bottom: 15px;
    }

    .contact-method a {
        display: inline-block;
        padding: 10px 24px;
        background: #f5f5f5;
        color: #1A3A52;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.3s;
        border: 1px solid #e0e0e0;
    }

    .contact-method a:hover {
        background: #1A3A52;
        color: white;
        border-color: #1A3A52;
    }

    .divider {
        width: 1px;
        background: #e0e0e0;
        height: 100%;
        margin: 0;
        min-height: 150px; /* Ensure divider has height */
    }

    .contact-footer {
        border-top: 2px solid #e0e0e0;
        padding-top: 30px;
        text-align: center;
        font-size: 14px;
        color: #999;
    }

    @media (max-width: 768px) {
        .contact-container {
            padding: 40px 25px;
        }

        .contact-content {
            display: grid;
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .divider {
            display: none;
        }

        .contact-container h2 {
            font-size: 24px;
        }
        
        .contact-method {
            padding: 0;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 20px;
        }

        .contact-method:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
    }
</style>
