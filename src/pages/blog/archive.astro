---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const byYearMonth: Record<string, Record<string, typeof allPosts>> = {};
allPosts.forEach((post) => {
  const d = new Date(post.data.date);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  if (!byYearMonth[y]) byYearMonth[y] = {};
  if (!byYearMonth[y][m]) byYearMonth[y][m] = [];
  byYearMonth[y][m].push(post);
});

const years = Object.keys(byYearMonth).sort((a, b) => Number(b) - Number(a));
const monthNames: Record<string, string> = {
  '01': '1月', '02': '2月', '03': '3月', '04': '4月', '05': '5月', '06': '6月',
  '07': '7月', '08': '8月', '09': '9月', '10': '10月', '11': '11月', '12': '12月',
};

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return `${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
}
---

<MainLayout title="文章彙整 - 呂依璇 Elaine Lu" currentPath="/blog">
  <div class="post">
    <div class="archive-header">
      <h1 class="section-title">文章彙整</h1>
      <a href="/blog" class="back-to-blog">返回全部文章</a>
    </div>
    {years.length === 0 ? (
      <p class="archive-empty">尚無文章</p>
    ) : (
      <div class="archive-list">
        {years.map((year) => (
          <section class="archive-year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="archive-year-title">{year} 年</h2>
            {Object.entries(byYearMonth[year])
              .sort(([a], [b]) => b.localeCompare(a))
              .map(([month, posts]) => (
                <div class="archive-month">
                  <h3 class="archive-month-title">{monthNames[month] || month}</h3>
                  <ul class="archive-posts">
                    {posts.map((post) => (
                      <li class="archive-post-item">
                        <span class="archive-date">{formatDate(post.data.date)}</span>
                        <a href={`/posts/${post.slug}`} class="archive-post-link">{post.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
          </section>
        ))}
      </div>
    )}
  </div>
</MainLayout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .archive-header .section-title {
    margin-bottom: 0 !important;
    flex: 1;
    min-width: 0;
  }
  .back-to-blog {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    padding: 6px 14px;
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    transition: all 0.2s;
    background: transparent;
    white-space: nowrap;
  }
  .back-to-blog:hover {
    background: var(--accent);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(232, 113, 76, 0.25);
  }
  .back-to-blog::before {
    content: '←';
    margin-right: 2px;
  }
  @media (max-width: 768px) {
    .archive-header {
      align-items: baseline;
      gap: 0.75rem;
    }
    .archive-header .section-title {
      font-size: 20px;
    }
    .back-to-blog {
      font-size: 13px;
      padding: 5px 12px;
    }
  }
  .archive-empty {
    text-align: center;
    color: #999;
    padding: 3rem 0;
  }
  .archive-list {
    max-width: 100%;
  }
  .archive-year {
    margin-bottom: 3rem;
  }
  .archive-year-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--accent);
  }
  .archive-month {
    margin-bottom: 1.5rem;
    margin-left: 0;
  }
  .archive-month-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
  }
  .archive-posts {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-left: 1rem;
  }
  .archive-post-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .archive-post-item:last-child {
    border-bottom: none;
  }
  .archive-date {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    min-width: 50px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .archive-post-link {
    color: var(--text);
    text-decoration: none;
    line-height: 1.5;
    flex: 1;
    transition: color 0.2s;
  }
  .archive-post-link:hover {
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .archive-year {
      margin-bottom: 2rem;
    }
    .archive-year-title {
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }
    .archive-month-title {
      font-size: 1rem;
    }
    .archive-posts {
      padding-left: 0.5rem;
    }
    .archive-post-item {
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem 0;
    }
    .archive-date {
      font-size: 0.8rem;
    }
  }
</style>
