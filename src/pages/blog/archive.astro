---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const byYearMonth: Record<string, Record<string, typeof allPosts>> = {};
allPosts.forEach((post) => {
  const d = new Date(post.data.date);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  if (!byYearMonth[y]) byYearMonth[y] = {};
  if (!byYearMonth[y][m]) byYearMonth[y][m] = [];
  byYearMonth[y][m].push(post);
});

const years = Object.keys(byYearMonth).sort((a, b) => Number(b) - Number(a));
const monthNames: Record<string, string> = {
  '01': '1月', '02': '2月', '03': '3月', '04': '4月', '05': '5月', '06': '6月',
  '07': '7月', '08': '8月', '09': '9月', '10': '10月', '11': '11月', '12': '12月',
};

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return `${d.getFullYear()}年${String(d.getMonth() + 1).padStart(2, '0')}月${String(d.getDate()).padStart(2, '0')}日`;
}
---

<MainLayout title="文章彙整 - 呂依璇 Elaine Lu" currentPath="/blog">
  <div class="post">
    <h1 class="section-title">文章彙整</h1>
    <p class="archive-desc"><a href="/blog">← 返回全部文章</a></p>
    {years.length === 0 ? (
      <p class="archive-empty">尚無文章</p>
    ) : (
      <div class="archive-list">
        {years.map((year) => (
          <section class="archive-year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="archive-year-title">{year} 年</h2>
            {Object.entries(byYearMonth[year])
              .sort(([a], [b]) => b.localeCompare(a))
              .map(([month, posts]) => (
                <div class="archive-month">
                  <h3 class="archive-month-title">{monthNames[month] || month}</h3>
                  <ul class="archive-posts">
                    {posts.map((post) => (
                      <li>
                        <a href={`/posts/${post.slug}`}>{post.data.title}</a>
                        <span class="archive-date">{formatDate(post.data.date)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
          </section>
        ))}
      </div>
    )}
  </div>
</MainLayout>

<style>
  .archive-desc {
    margin-bottom: 2rem;
    color: #666;
  }
  .archive-empty {
    text-align: center;
    color: #999;
  }
  .archive-year {
    margin-bottom: 2.5rem;
  }
  .archive-year-title {
    font-size: 1.35rem;
    color: #1A3A52;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #E8714C;
  }
  .archive-month {
    margin-bottom: 1.25rem;
  }
  .archive-month-title {
    font-size: 1rem;
    color: #666;
    margin-bottom: 0.5rem;
  }
  .archive-posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .archive-posts li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .archive-posts a {
    color: #1A3A52;
    text-decoration: none;
  }
  .archive-posts a:hover {
    color: #E8714C;
  }
  .archive-date {
    font-size: 0.85rem;
    color: #999;
  }
</style>
